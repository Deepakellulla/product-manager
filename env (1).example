# Copy this file to ".env" and fill in the values.
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# The long ID in your Google Sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your_google_sheet_id
# Telegram user IDs allowed to use the bot, comma separated (send /myid to the bot to find yours)
ADMIN_IDS=123456789
GOOGLE_CREDS_FILE=service_account.json
# Sheet tab names, exactly as they appear in your Google Sheet
TABS=All Products,Bundles,PC Games,Console Games
