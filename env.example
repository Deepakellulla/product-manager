# Copy this file to ".env" and fill in the values.
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# The long ID in your Google Sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your_google_sheet_id
# Telegram user IDs allowed to use the bot, comma separated (send /myid to the bot to find yours)
ADMIN_IDS=123456789
GOOGLE_CREDS_FILE=service_account.json
# Alternative to GOOGLE_CREDS_FILE, used for hosting on Railway (see DEPLOY_RAILWAY.md):
# base64 of your service_account.json, as one line. Leave blank if using GOOGLE_CREDS_FILE.
GOOGLE_CREDS_JSON=
# Sheet tab names, exactly as they appear in your Google Sheet
TABS=All Products,Bundles,PC Games,Console Games
# For screenshot bulk-import (/import). Free - get one at https://aistudio.google.com/apikey
# (just a Google account, no card needed). Leave blank to skip this feature.
GEMINI_API_KEY=
